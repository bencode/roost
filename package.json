{
  "name": "roost",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scheme-first React bindings powered by Guile Hoot",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "repl": "node tooling/roost-repl.js",
    "pages": "node tooling/publish-pages.js",
    "test": "pnpm test:scheme && pnpm test:js",
    "test:scheme": "guile --no-auto-compile -L tests/host -L modules tests/ui-construction.scm",
    "test:js": "vitest run"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-query": "5.104.0",
    "jsdom": "27.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "todomvc-app-css": "2.4.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@10.14.0"
}
